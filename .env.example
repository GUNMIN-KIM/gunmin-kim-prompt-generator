# Copy to .env.local and fill in values for the environment that runs the app.
# Never commit the filled-in file.
DATABASE_URL=
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
# Google Gemma 4 instruct model. Override if the connected Forge catalog uses another ID.
BUILT_IN_LLM_MODEL=gemma-4-31b-it
JWT_SECRET=
OAUTH_SERVER_URL=https://api.manus.im
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=https://manus.im
